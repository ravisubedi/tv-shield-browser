<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navy" android:orientation="vertical">

    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="72dp" android:gravity="center_vertical" android:orientation="horizontal"
        android:padding="8dp">
        <Button android:id="@+id/backButton" style="@style/ToolbarButton" android:text="@string/back" />
        <Button android:id="@+id/forwardButton" style="@style/ToolbarButton" android:text="@string/forward" />
        <Button android:id="@+id/homeButton" style="@style/ToolbarButton" android:text="@string/home" />
        <EditText android:id="@+id/addressBar" android:layout_width="0dp" android:layout_height="52dp"
            android:layout_marginHorizontal="8dp" android:layout_weight="1" android:background="@drawable/address_background"
            android:hint="@string/address_hint" android:imeOptions="actionGo" android:inputType="textUri"
            android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="#111827" android:textColorHint="#64748B" />
        <Button android:id="@+id/clearButton" style="@style/ToolbarButton"
            android:minWidth="58dp" android:text="×" android:contentDescription="@string/clear_address" />
        <Button android:id="@+id/goButton" style="@style/ToolbarButton" android:text="@string/go" />
        <Button android:id="@+id/bookmarkButton" style="@style/ToolbarButton"
            android:minWidth="64dp" android:text="☆" android:contentDescription="@string/add_bookmark" />
        <Button android:id="@+id/overflowButton" style="@style/ToolbarButton"
            android:minWidth="64dp" android:text="⋮" android:contentDescription="@string/browser_menu" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:progressTint="@color/orange" />
    <FrameLayout android:id="@+id/browserFrame" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/white" android:focusable="true" android:nextFocusUp="@id/addressBar" />
        <View android:id="@+id/mouseCursor" android:layout_width="28dp" android:layout_height="28dp"
            android:background="@drawable/mouse_cursor" android:elevation="20dp" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
